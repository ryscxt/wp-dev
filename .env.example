# Skopiuj te zmienne do zakładki Environment w Dokploy (lub do pliku .env
# przy uruchamianiu lokalnie) i uzupełnij wartości.

# Domena wpisana w Dokploy - bez https:// i bez ścieżki.
WP_DOMAIN=dev.rys.network

# Ścieżka domeny w Dokploy. Puste = witryna w katalogu głównym domeny.
WP_PATH=/przechowuj

# Ustaw na "true" TYLKO jeżeli w Dokploy włączyłeś "Strip Path" dla domeny.
WP_STRIP_PREFIX=false

WP_SCHEME=https

# Baza danych
DB_NAME=wordpress
DB_PASSWORD=zmien-to-na-dlugie-losowe-haslo

# Sól do kluczy uwierzytelniających. Dowolny długi losowy ciąg - trzymaj go
# stały, bo jego zmiana wylogowuje wszystkich użytkowników.
# Alternatywnie ustaw pełny zestaw: WORDPRESS_AUTH_KEY, WORDPRESS_SECURE_AUTH_KEY,
# WORDPRESS_LOGGED_IN_KEY, WORDPRESS_NONCE_KEY, WORDPRESS_AUTH_SALT,
# WORDPRESS_SECURE_AUTH_SALT, WORDPRESS_LOGGED_IN_SALT, WORDPRESS_NONCE_SALT
# z https://api.wordpress.org/secret-key/1.1/salt/
WP_SALT_SECRET=zmien-to-na-dlugi-losowy-ciag

# Opcjonalne
WORDPRESS_DEBUG=0
WP_MEMORY_LIMIT=256M
WORDPRESS_TABLE_PREFIX=wp_
